# Copier ce fichier en .env et remplir les valeurs.
# Ne JAMAIS committer .env (cf. .gitignore).

# Qdrant Cloud — région EU obligatoire (souveraineté + RGPD)
QDRANT_URL=https://your-cluster-id.eu-central.aws.cloud.qdrant.io
QDRANT_API_KEY=qdrant_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nom de la collection. Utiliser l'alias en prod (swap atomique sur migration).
QDRANT_COLLECTION=tomai_educational

# Mistral AI (souveraineté EU)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
